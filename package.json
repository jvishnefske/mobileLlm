{
  "name": "mobilellm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local LLM agent PWA — runs a small language model entirely in your browser, offline-capable, installable on Android and iOS",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@wllama/wllama": "^2.3.1",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
